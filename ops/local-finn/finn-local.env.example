# Copy nothing from production. OPENAI_API_KEY is loaded only from
# ~/tradamind-local-secrets/finn-development.env by the local commands.
APP_ENV=local_finn
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=finn_local
DB_USER=finn_local
DB_PASS=finn_local_only
REDIS_URL=redis://127.0.0.1:56379/0
CELERY_BROKER_URL=redis://127.0.0.1:56379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/1
CELERY_QUEUE_PREFIX=local-finn-
OPENAI_CALLS_ENABLED=true
JWT_SECRET_KEY=local-finn-not-production-jwt-secret
SECRET_KEY=local-finn-not-production-app-secret
FINN_LOCAL_SAFE_ADAPTERS=1
FINN_LOCAL_FIXTURE_USER_EMAIL=finn-build-fixture@example.test
